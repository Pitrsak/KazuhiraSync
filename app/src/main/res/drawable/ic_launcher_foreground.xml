<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher mark: target-scan reticle in the app's amber (idroid_amber) and white (idroid_text_main) -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Viewfinder corner brackets (same language as the scan-target tile icon) -->
    <path
        android:pathData="M33,43 L33,33 L43,33 M65,33 L75,33 L75,43 M33,65 L33,75 L43,75 M65,75 L75,75 L75,65"
        android:strokeColor="#E8B33A"
        android:strokeWidth="4"
        android:strokeLineCap="square"
        android:strokeLineJoin="miter" />

    <!-- Reticle ring -->
    <path
        android:pathData="M54,41 A13,13 0 1,1 54,67 A13,13 0 1,1 54,41 Z"
        android:strokeColor="#F2FAFC"
        android:strokeWidth="3.5" />

    <!-- Crosshair ticks -->
    <path
        android:pathData="M54,37 L54,45 M54,63 L54,71 M37,54 L45,54 M63,54 L71,54"
        android:strokeColor="#F2FAFC"
        android:strokeWidth="3" />

    <!-- Centre dot -->
    <path
        android:pathData="M54,50 A4,4 0 1,1 54,58 A4,4 0 1,1 54,50 Z"
        android:fillColor="#F2FAFC" />

</vector>
