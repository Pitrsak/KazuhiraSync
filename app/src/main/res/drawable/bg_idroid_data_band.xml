<?xml version="1.0" encoding="utf-8"?>
<!-- Footer strip inside a data tile ("Total Development Grade 393") -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/idroid_data_card_band" />
        </shape>
    </item>
    <item android:gravity="top" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/idroid_data_card_text_dim" />
        </shape>
    </item>
</layer-list>
