<?xml version="1.0" encoding="utf-8"?>
<!-- iDroid panel: dense teal glass with a hairline white frame, square corners -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/idroid_card" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/idroid_border" />
        </shape>
    </item>
    <!-- Bright top rule, like the header line on iDroid windows -->
    <item android:gravity="top" android:height="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/idroid_border_glow" />
        </shape>
    </item>
</layer-list>
