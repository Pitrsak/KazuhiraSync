<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_idroid_card"
    android:padding="12dp"
    android:layout_marginVertical="3dp">

    <!-- Header line with tactical diamond icon & title & calories -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/tvMealCalories"
            android:layout_centerVertical="true">

            <!-- Cyan indicator dot / diamond -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◆"
                android:textSize="10sp"
                android:textColor="@color/idroid_cyan"
                android:layout_marginEnd="6dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMealTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Grilled Chicken"
                    android:textSize="15sp"
                    android:fontFamily="@font/rajdhani_bold"
                    android:letterSpacing="0.06"
                    android:textColor="@color/idroid_text_main"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvMealTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12:30"
                    android:textSize="10sp"
                    android:textColor="@color/idroid_text_dim"
                    android:fontFamily="@font/share_tech_mono" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvMealCalories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="550"
            android:textSize="20sp"
            android:fontFamily="@font/share_tech_mono"
            android:textColor="@color/idroid_amber" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/idroid_border"
        android:layout_marginBottom="8dp" />

    <!-- Macro Badges Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvProteinBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="P 35g"
            android:textSize="10sp"
            android:textColor="@color/idroid_green"
            android:background="@color/idroid_cyan_dim"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp"
            android:layout_marginEnd="6dp"
            android:fontFamily="@font/share_tech_mono" />

        <TextView
            android:id="@+id/tvCarbBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="C 50g"
            android:textSize="10sp"
            android:textColor="@color/idroid_blue"
            android:background="@color/idroid_cyan_dim"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp"
            android:layout_marginEnd="6dp"
            android:fontFamily="@font/share_tech_mono" />

        <TextView
            android:id="@+id/tvFatBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="F 15g"
            android:textSize="10sp"
            android:textColor="@color/idroid_amber"
            android:background="@color/idroid_amber_dim"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp"
            android:fontFamily="@font/share_tech_mono" />
    </LinearLayout>

</LinearLayout>
