<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:background="@drawable/bg_idroid_root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_idroid_card"
        android:padding="18dp">

        <View
            android:layout_width="36dp"
            android:layout_height="2dp"
            android:background="@color/idroid_cyan"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONFIRM RATION INTEL"
            android:textSize="16sp"
            android:letterSpacing="0.08"
            android:textColor="@color/idroid_cyan_bright"
            android:fontFamily="@font/rajdhani_bold"
            android:layout_marginBottom="14dp" />

        <ImageView
            android:id="@+id/imgMealPreview"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:background="@color/idroid_bg"
            android:layout_marginBottom="16dp"
            android:contentDescription="Meal preview" />

        <!-- Meal Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RATION DESIGNATION"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:textColor="@color/idroid_cyan"
            android:fontFamily="@font/rajdhani_bold" />

        <EditText
            android:id="@+id/etMealName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:textColor="@color/idroid_text_main"
            android:textColorHint="@color/idroid_text_faint"
            android:backgroundTint="@color/idroid_cyan"
            android:fontFamily="@font/rajdhani_semibold"
            android:layout_marginBottom="14dp" />

        <!-- Calories -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CALORIC VALUE (KCAL)"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:textColor="@color/idroid_cyan"
            android:fontFamily="@font/rajdhani_bold" />

        <EditText
            android:id="@+id/etCalories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:textColor="@color/idroid_cyan_bright"
            android:textColorHint="@color/idroid_text_faint"
            android:backgroundTint="@color/idroid_cyan"
            android:fontFamily="@font/share_tech_mono"
            android:layout_marginBottom="14dp" />

        <!-- Macros Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PROTEIN (G)"
                    android:textSize="10sp"
                    android:textColor="@color/idroid_macro_protein"
                    android:fontFamily="@font/rajdhani_bold" />
                <EditText
                    android:id="@+id/etProtein"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/idroid_text_main"
                    android:textColorHint="@color/idroid_text_faint"
                    android:backgroundTint="@color/idroid_macro_protein"
                    android:fontFamily="@font/share_tech_mono" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingHorizontal="2dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CARBS (G)"
                    android:textSize="10sp"
                    android:textColor="@color/idroid_macro_carbs"
                    android:fontFamily="@font/rajdhani_bold" />
                <EditText
                    android:id="@+id/etCarbs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/idroid_text_main"
                    android:textColorHint="@color/idroid_text_faint"
                    android:backgroundTint="@color/idroid_macro_carbs"
                    android:fontFamily="@font/share_tech_mono" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FAT (G)"
                    android:textSize="10sp"
                    android:textColor="@color/idroid_macro_fat"
                    android:fontFamily="@font/rajdhani_bold" />
                <EditText
                    android:id="@+id/etFat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/idroid_text_main"
                    android:textColorHint="@color/idroid_text_faint"
                    android:backgroundTint="@color/idroid_macro_fat"
                    android:fontFamily="@font/share_tech_mono" />
            </LinearLayout>
        </LinearLayout>

        <!-- Notes -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ANALYSIS NOTES"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:textColor="@color/idroid_text_dim"
            android:fontFamily="@font/rajdhani_bold" />

        <TextView
            android:id="@+id/tvNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/idroid_text_dim"
            android:fontFamily="@font/share_tech_mono"
            android:layout_marginBottom="18dp" />

        <!-- Buttons -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnCancelMeal"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="ABORT"
                android:fontFamily="@font/rajdhani_bold"
                android:letterSpacing="0.08"
                android:textSize="13sp"
                android:textColor="@color/idroid_cyan"
                app:backgroundTint="@android:color/transparent"
                app:strokeColor="@color/idroid_cyan"
                app:strokeWidth="1.2dp"
                app:cornerRadius="3dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnSaveMeal"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintTop_toTopOf="@id/btnSaveMeal"
                app:layout_constraintBottom_toBottomOf="@id/btnSaveMeal" />

            <Button
                android:id="@+id/btnSaveMeal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="LOG RATION"
                android:textSize="13sp"
                android:fontFamily="@font/rajdhani_bold"
                android:letterSpacing="0.08"
                android:textColor="@color/idroid_btn_primary_text"
                app:backgroundTint="@color/idroid_btn_primary_bg"
                app:strokeColor="@color/idroid_cyan"
                app:strokeWidth="1dp"
                app:cornerRadius="3dp"
                android:paddingVertical="11dp"
                app:layout_constraintStart_toEndOf="@id/btnCancelMeal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1.3"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</ScrollView>
