<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:background="@drawable/bg_idroid_root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_idroid_card"
        android:padding="20dp">

        <View
            android:layout_width="40dp"
            android:layout_height="2dp"
            android:background="@color/idroid_amber"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONFIRM RATION INTEL"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="@color/idroid_amber"
            android:fontFamily="monospace"
            android:layout_marginBottom="16dp" />

        <ImageView
            android:id="@+id/imgMealPreview"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:background="@color/idroid_bg"
            android:layout_marginBottom="18dp"
            android:contentDescription="Meal preview" />

        <!-- Meal Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RATION DESIGNATION"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:textColor="@color/idroid_cyan"
            android:fontFamily="monospace" />

        <EditText
            android:id="@+id/etMealName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:textColor="@color/idroid_text_main"
            android:textColorHint="@color/idroid_text_faint"
            android:backgroundTint="@color/idroid_cyan"
            android:layout_marginBottom="14dp" />

        <!-- Calories -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CALORIC VALUE (KCAL)"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:textColor="@color/idroid_amber"
            android:fontFamily="monospace" />

        <EditText
            android:id="@+id/etCalories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:textColor="@color/idroid_amber"
            android:textColorHint="@color/idroid_text_faint"
            android:backgroundTint="@color/idroid_amber"
            android:fontFamily="monospace"
            android:layout_marginBottom="14dp" />

        <!-- Macros Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PROTEIN (G)"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/idroid_green"
                    android:fontFamily="monospace" />
                <EditText
                    android:id="@+id/etProtein"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/idroid_text_main"
                    android:textColorHint="@color/idroid_text_faint"
                    android:backgroundTint="@color/idroid_green" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingHorizontal="2dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CARBS (G)"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/idroid_blue"
                    android:fontFamily="monospace" />
                <EditText
                    android:id="@+id/etCarbs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/idroid_text_main"
                    android:textColorHint="@color/idroid_text_faint"
                    android:backgroundTint="@color/idroid_blue" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FAT (G)"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/idroid_amber"
                    android:fontFamily="monospace" />
                <EditText
                    android:id="@+id/etFat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/idroid_text_main"
                    android:textColorHint="@color/idroid_text_faint"
                    android:backgroundTint="@color/idroid_amber" />
            </LinearLayout>
        </LinearLayout>

        <!-- Notes -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ANALYSIS NOTES"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:textColor="@color/idroid_text_dim"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/idroid_text_dim"
            android:layout_marginBottom="20dp" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btnCancelMeal"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ABORT"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/idroid_cyan"
                app:backgroundTint="@android:color/transparent"
                app:strokeColor="@color/idroid_cyan"
                app:strokeWidth="1.5dp"
                app:cornerRadius="8dp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnSaveMeal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOG TO HEALTH CONNECT"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:textColor="#080D14"
                app:backgroundTint="@color/idroid_amber"
                app:cornerRadius="8dp"
                app:strokeWidth="0dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
