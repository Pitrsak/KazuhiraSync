<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:background="@drawable/bg_idroid_root">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_idroid_card"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:background="@color/idroid_amber"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[ SYSTEM CONFIGURATION ]"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/idroid_amber"
                android:fontFamily="monospace"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GOOGLE AI API KEY"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/idroid_cyan"
                android:fontFamily="monospace" />

            <EditText
                android:id="@+id/etApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="@color/idroid_text_main"
                android:textColorHint="@color/idroid_text_faint"
                android:backgroundTint="@color/idroid_cyan"
                android:hint="Enter Gemini API key"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GEMINI MODEL PRESET"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/idroid_amber"
                android:fontFamily="monospace" />

            <Spinner
                android:id="@+id/spinnerModelPreset"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CUSTOM MODEL NAME"
                android:textSize="10sp"
                android:textColor="@color/idroid_text_dim"
                android:fontFamily="monospace" />

            <EditText
                android:id="@+id/etModelName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="@color/idroid_text_main"
                android:textColorHint="@color/idroid_text_faint"
                android:backgroundTint="@color/idroid_amber"
                android:hint="e.g. gemini-3.5-flash-lite"
                android:layout_marginBottom="22dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <Button
                    android:id="@+id/btnCancelSettings"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CANCEL"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textColor="@color/idroid_cyan"
                    app:backgroundTint="@android:color/transparent"
                    app:strokeColor="@color/idroid_cyan"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="4dp"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnSaveSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SAVE CONFIG"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:textColor="#080D14"
                    app:backgroundTint="@color/idroid_amber"
                    app:cornerRadius="4dp"
                    app:strokeWidth="0dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Viewfinder corner brackets -->
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_corner_tl"
            android:layout_gravity="start|top"
            android:layout_margin="5dp"
            android:contentDescription="@null" />
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_corner_tr"
            android:layout_gravity="end|top"
            android:layout_margin="5dp"
            android:contentDescription="@null" />
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_corner_bl"
            android:layout_gravity="start|bottom"
            android:layout_margin="5dp"
            android:contentDescription="@null" />
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_corner_br"
            android:layout_gravity="end|bottom"
            android:layout_margin="5dp"
            android:contentDescription="@null" />
    </FrameLayout>
</ScrollView>
