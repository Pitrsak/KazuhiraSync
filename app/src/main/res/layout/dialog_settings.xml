<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:background="@drawable/bg_idroid_root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_idroid_card"
        android:padding="18dp">

        <View
            android:layout_width="36dp"
            android:layout_height="2dp"
            android:background="@color/idroid_amber"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SYSTEM CONFIGURATION"
            android:textSize="16sp"
            android:letterSpacing="0.08"
            android:textColor="@color/idroid_amber"
            android:fontFamily="@font/rajdhani_bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GOOGLE AI API KEY"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:textColor="@color/idroid_cyan"
            android:fontFamily="@font/rajdhani_bold" />

        <EditText
            android:id="@+id/etApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:textColor="@color/idroid_text_main"
            android:textColorHint="@color/idroid_text_faint"
            android:backgroundTint="@color/idroid_cyan"
            android:hint="Enter Gemini API key"
            android:fontFamily="@font/share_tech_mono"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GEMINI MODEL PRESET"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:textColor="@color/idroid_amber"
            android:fontFamily="@font/rajdhani_bold" />

        <Spinner
            android:id="@+id/spinnerModelPreset"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CUSTOM MODEL NAME"
            android:textSize="10sp"
            android:textColor="@color/idroid_text_dim"
            android:fontFamily="@font/share_tech_mono" />

        <EditText
            android:id="@+id/etModelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textColor="@color/idroid_text_main"
            android:textColorHint="@color/idroid_text_faint"
            android:backgroundTint="@color/idroid_amber"
            android:hint="e.g. gemini-3.5-flash-lite"
            android:fontFamily="@font/share_tech_mono"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btnCancelSettings"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CANCEL"
                android:fontFamily="@font/rajdhani_bold"
                android:letterSpacing="0.08"
                android:textColor="@color/idroid_cyan"
                app:backgroundTint="@android:color/transparent"
                app:strokeColor="@color/idroid_cyan"
                app:strokeWidth="1.2dp"
                app:cornerRadius="3dp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnSaveSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SAVE CONFIG"
                android:fontFamily="@font/rajdhani_bold"
                android:letterSpacing="0.06"
                android:textColor="#060C14"
                app:backgroundTint="@color/idroid_amber"
                app:cornerRadius="3dp"
                app:strokeWidth="0dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
