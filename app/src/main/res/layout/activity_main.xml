<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@drawable/bg_idroid_root">

    <!-- Layer 1: Always-on Camera Feed (TextureView-backed so it can be colour graded) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreviewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Layer 2: iDroid Holographic Overlay (teal wash, light band, grain, scanlines) -->
    <com.kazuhira.hcsync.IdroidOverlayView
        android:id="@+id/idroidOverlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Layer 3: Main iDroid User Interface -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- ===================== iDroid System Header ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KAZUHIRA SYNC VER 2.3.0"
                    android:textSize="11sp"
                    android:fontFamily="@font/share_tech_mono"
                    android:letterSpacing="0.04"
                    android:textColor="@color/idroid_text_sub" />

                <TextView
                    android:id="@+id/tvModelSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GEMINI // GEMINI-3.8-FLASH"
                    android:textSize="12sp"
                    android:fontFamily="@font/rajdhani_bold"
                    android:letterSpacing="0.06"
                    android:textColor="@color/idroid_amber" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvOpticalStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OPTICAL HUD // STANDBY"
                android:textSize="10sp"
                android:fontFamily="@font/share_tech_mono"
                android:letterSpacing="0.06"
                android:textColor="@color/idroid_text_dim" />
        </LinearLayout>

        <!-- ===================== iDroid Tab Strip (INTEL FILE | RATIONS | CONFIG) ===================== -->
        <com.kazuhira.hcsync.IdroidTabBar
            android:id="@+id/tabBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp" />

        <!-- Cards Container (allows parallax tilt without clipping card borders) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- ===================== Today Summary: solid cyan iDroid data tile ===================== -->
            <LinearLayout
                android:id="@+id/cardTodaySummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="12dp">

                <!-- Tile caption sits above the tile, like the player name on FOB cards -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daily Ration Status"
                    android:textSize="13sp"
                    android:fontFamily="@font/rajdhani_semibold"
                    android:textColor="@color/idroid_text_main"
                    android:layout_marginBottom="2dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_idroid_data_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Caloric Intake"
                            android:textSize="13sp"
                            android:fontFamily="@font/rajdhani_semibold"
                            android:textColor="@color/idroid_data_card_text" />

                        <TextView
                            android:id="@+id/tvTodayCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 RATIONS"
                            android:textSize="11sp"
                            android:fontFamily="@font/share_tech_mono"
                            android:textColor="@color/idroid_data_card_text" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <TextView
                            android:id="@+id/tvTodayCalories"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="34sp"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/share_tech_mono"
                            android:textColor="@color/idroid_data_card_text" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="kcal"
                            android:textSize="13sp"
                            android:fontFamily="@font/share_tech_mono"
                            android:textColor="@color/idroid_data_card_text_dim"
                            android:layout_marginStart="6dp"
                            android:layout_marginBottom="4dp" />
                    </LinearLayout>

                    <!-- Footer band: macro totals -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_idroid_data_band"
                        android:layout_marginTop="6dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:weightSum="3">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Protein"
                                android:textSize="12sp"
                                android:fontFamily="@font/rajdhani_medium"
                                android:textColor="@color/idroid_data_card_text_dim" />
                            <TextView
                                android:id="@+id/tvTodayProtein"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0g"
                                android:textSize="14sp"
                                android:fontFamily="@font/share_tech_mono"
                                android:textColor="@color/idroid_data_card_text"
                                android:layout_marginStart="5dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Carbs"
                                android:textSize="12sp"
                                android:fontFamily="@font/rajdhani_medium"
                                android:textColor="@color/idroid_data_card_text_dim" />
                            <TextView
                                android:id="@+id/tvTodayCarbs"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0g"
                                android:textSize="14sp"
                                android:fontFamily="@font/share_tech_mono"
                                android:textColor="@color/idroid_data_card_text"
                                android:layout_marginStart="5dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fat"
                                android:textSize="12sp"
                                android:fontFamily="@font/rajdhani_medium"
                                android:textColor="@color/idroid_data_card_text_dim" />
                            <TextView
                                android:id="@+id/tvTodayFat"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0g"
                                android:textSize="14sp"
                                android:fontFamily="@font/share_tech_mono"
                                android:textColor="@color/idroid_data_card_text"
                                android:layout_marginStart="5dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ===================== Target Acquisition: iDroid menu rows ===================== -->
            <LinearLayout
                android:id="@+id/cardAcquireTarget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Target Acquisition"
                    android:textSize="16sp"
                    android:fontFamily="@font/rajdhani_semibold"
                    android:textColor="@color/idroid_text_main"
                    android:layout_marginBottom="4dp" />

                <!-- Highlighted (selected) row -->
                <Button
                    android:id="@+id/btnTakePhoto"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="Capture Target Scan"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:fontFamily="@font/rajdhani_semibold"
                    android:gravity="center_vertical|start"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textColor="@color/idroid_btn_primary_text"
                    app:backgroundTint="@color/idroid_btn_primary_bg"
                    app:rippleColor="@color/idroid_cyan"
                    app:cornerRadius="0dp" />

                <!-- Regular row -->
                <Button
                    android:id="@+id/btnPickGallery"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="Load Intel File"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:fontFamily="@font/rajdhani_semibold"
                    android:gravity="center_vertical|start"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/idroid_text_main"
                    app:backgroundTint="@color/idroid_cyan_faint"
                    app:strokeColor="@color/idroid_border_dim"
                    app:strokeWidth="1dp"
                    app:rippleColor="@color/idroid_cyan_dim"
                    app:cornerRadius="0dp" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="4dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/idroid_cyan_glow"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===================== Ration Log ("Results Log" list) ===================== -->
        <!-- Strictly clipped so list items never overlap upper cards when scrolling -->
        <LinearLayout
            android:id="@+id/layoutRationSection"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:clipChildren="true"
            android:clipToPadding="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ration Log"
                android:textSize="16sp"
                android:fontFamily="@font/rajdhani_semibold"
                android:textColor="@color/idroid_text_main"
                android:layout_marginBottom="4dp" />

            <!-- Column header band -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_idroid_column_header"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:text="Time"
                    android:textSize="12sp"
                    android:fontFamily="@font/rajdhani_medium"
                    android:textColor="@color/idroid_text_sub" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ration"
                    android:textSize="12sp"
                    android:fontFamily="@font/rajdhani_medium"
                    android:textColor="@color/idroid_text_sub" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="kcal"
                    android:textSize="12sp"
                    android:fontFamily="@font/rajdhani_medium"
                    android:textColor="@color/idroid_text_sub"
                    android:layout_marginEnd="26dp" />
            </LinearLayout>

            <ListView
                android:id="@+id/listViewHistory"
                android:background="@color/idroid_hud_box"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:scrollbars="vertical"
                android:scrollbarSize="2dp"
                android:scrollbarThumbVertical="@color/idroid_text_main"
                android:scrollbarTrackVertical="@color/idroid_border_dim"
                android:scrollbarStyle="outsideOverlay"
                android:fadeScrollbars="false"
                android:listSelector="@android:color/transparent"
                android:overScrollMode="never" />
        </LinearLayout>

        <!-- ===================== Footer: description line, button prompts, HUD stats ===================== -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Awaiting target acquisition. Point optical sensor at meal."
            android:textSize="13sp"
            android:fontFamily="@font/rajdhani_medium"
            android:textColor="@color/idroid_text_main"
            android:layout_marginTop="8dp"
            android:maxLines="3"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_marginTop="6dp">

            <!-- Button prompts -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TAP"
                        android:textSize="9sp"
                        android:fontFamily="@font/share_tech_mono"
                        android:textColor="@color/idroid_text_main"
                        android:background="@drawable/bg_idroid_prompt_glyph"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="1dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ration Details"
                        android:textSize="13sp"
                        android:fontFamily="@font/rajdhani_medium"
                        android:textColor="@color/idroid_text_main"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <!-- Tap to push rations that have not reached Health Connect yet -->
                <LinearLayout
                    android:id="@+id/layoutPendingSync"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    android:paddingVertical="2dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvPendingSync"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⟳ Sync 2 Pending"
                        android:textSize="13sp"
                        android:fontFamily="@font/rajdhani_medium"
                        android:textColor="@color/idroid_warn"
                        android:background="@drawable/bg_idroid_warn_badge"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- HUD stats block (TIME / GMP / HEROISM) -->
            <GridLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="2">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TIME"
                    android:textSize="10sp"
                    android:fontFamily="@font/share_tech_mono"
                    android:textColor="@color/idroid_text_sub"
                    android:layout_marginEnd="14dp" />

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:format12Hour="hh:mm"
                    android:format24Hour="HH:mm"
                    android:textSize="10sp"
                    android:fontFamily="@font/share_tech_mono"
                    android:textColor="@color/idroid_text_main" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RATIONS"
                    android:textSize="10sp"
                    android:fontFamily="@font/share_tech_mono"
                    android:textColor="@color/idroid_text_sub"
                    android:layout_marginEnd="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvHudRations"
                    android:layout_gravity="end"
                    android:text="0"
                    android:textSize="10sp"
                    android:fontFamily="@font/share_tech_mono"
                    android:textColor="@color/idroid_text_main" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AVG/7D"
                    android:textSize="10sp"
                    android:fontFamily="@font/share_tech_mono"
                    android:textColor="@color/idroid_text_sub"
                    android:layout_marginEnd="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvHudAvg"
                    android:layout_gravity="end"
                    android:text="0"
                    android:textSize="10sp"
                    android:fontFamily="@font/share_tech_mono"
                    android:textColor="@color/idroid_text_main" />
            </GridLayout>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
