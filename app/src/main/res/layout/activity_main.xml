<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_idroid_root">

    <!-- ===== Top Header Bar ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_launcher_foreground"
            android:layout_marginEnd="10dp"
            android:contentDescription="Kazuhira Sync" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KAZUHIRA SYNC"
                android:textSize="19sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:textColor="@color/idroid_text_main" />

            <TextView
                android:id="@+id/tvModelSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="iDROID SYSTEM // GEMINI-3.5-FLASH-LITE"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:textColor="@color/idroid_cyan"
                android:fontFamily="monospace" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:src="@drawable/ic_status_dot"
                android:layout_marginEnd="5dp"
                android:contentDescription="status" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BUILD 1.1.3"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:textColor="@color/idroid_text_dim"
                android:fontFamily="monospace" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:src="@android:drawable/ic_menu_preferences"
            app:tint="@color/idroid_amber" />
    </LinearLayout>

    <!-- Header divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/idroid_border"
        android:layout_marginBottom="16dp" />

    <!-- ===== Main Scanner Card (viewfinder frame) ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_idroid_card"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="[ FOOD INTEL // ACQUIRE TARGET ]"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/idroid_cyan"
                    android:fontFamily="monospace" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ONLINE"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/idroid_green"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="14dp">

                <Button
                    android:id="@+id/btnTakePhoto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="CAMERA SCAN"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textColor="#070B12"
                    app:backgroundTint="@color/idroid_amber"
                    app:cornerRadius="4dp"
                    app:strokeWidth="0dp"
                    android:paddingVertical="12dp" />

                <Button
                    android:id="@+id/btnPickGallery"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="GALLERY FILE"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textColor="@color/idroid_cyan"
                    app:backgroundTint="@android:color/transparent"
                    app:strokeColor="@color/idroid_cyan"
                    app:strokeWidth="1.5dp"
                    app:cornerRadius="4dp"
                    android:paddingVertical="12dp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:indeterminateTint="@color/idroid_cyan"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Awaiting target acquisition. Capture or select food photo."
                android:textSize="12sp"
                android:textColor="@color/idroid_text_dim"
                android:textAlignment="center"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Viewfinder corner brackets -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_corner_tl"
            android:layout_gravity="start|top"
            android:layout_margin="5dp"
            android:contentDescription="@null" />
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_corner_tr"
            android:layout_gravity="end|top"
            android:layout_margin="5dp"
            android:contentDescription="@null" />
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_corner_bl"
            android:layout_gravity="start|bottom"
            android:layout_margin="5dp"
            android:contentDescription="@null" />
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_corner_br"
            android:layout_gravity="end|bottom"
            android:layout_margin="5dp"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- ===== History Header ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="[ RATION LOG // SUPPLY HISTORY ]"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/idroid_amber"
            android:fontFamily="monospace" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="0.6"
            android:background="@color/idroid_border" />
    </LinearLayout>

    <ListView
        android:id="@+id/listViewHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="vertical"
        android:scrollbarThumbVertical="@color/idroid_border" />

</LinearLayout>
