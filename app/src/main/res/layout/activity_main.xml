<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_idroid_root">

    <!-- ===================== Header ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_launcher_foreground"
            android:layout_marginEnd="12dp"
            android:contentDescription="Kazuhira Sync" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KAZUHIRA SYNC"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:textColor="@color/idroid_text_main" />

            <TextView
                android:id="@+id/tvModelSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="iDROID SYSTEM // GEMINI-3.5-FLASH-LITE"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/idroid_cyan"
                android:fontFamily="monospace" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:src="@android:drawable/ic_menu_preferences"
            app:tint="@color/idroid_text_dim" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/idroid_border"
        android:layout_marginBottom="14dp" />

    <!-- ===================== Today Summary Card ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_idroid_card"
        android:padding="18dp"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TODAY"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:textColor="@color/idroid_cyan"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvTodayCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 RATIONS"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/idroid_text_dim"
                android:fontFamily="monospace" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/tvTodayCalories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="34sp"
                android:textStyle="bold"
                android:textColor="@color/idroid_amber"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KCAL"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/idroid_text_dim"
                android:fontFamily="monospace"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="7dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/idroid_border"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <!-- Protein -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PROTEIN"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/idroid_green"
                    android:fontFamily="monospace" />
                <TextView
                    android:id="@+id/tvTodayProtein"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0g"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/idroid_text_main"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Carbs -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CARBS"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/idroid_blue"
                    android:fontFamily="monospace" />
                <TextView
                    android:id="@+id/tvTodayCarbs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0g"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/idroid_text_main"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Fat -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FAT"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/idroid_amber"
                    android:fontFamily="monospace" />
                <TextView
                    android:id="@+id/tvTodayFat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0g"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/idroid_text_main"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ===================== Scan Card ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_idroid_card"
        android:padding="18dp"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ACQUIRE TARGET"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:textColor="@color/idroid_cyan"
                android:fontFamily="monospace" />

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_dot_green"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ONLINE"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:textColor="@color/idroid_green"
                android:fontFamily="monospace" />
        </LinearLayout>

        <Button
            android:id="@+id/btnTakePhoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CAMERA SCAN"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="#070B12"
            app:backgroundTint="@color/idroid_amber"
            app:cornerRadius="8dp"
            app:strokeWidth="0dp"
            android:paddingVertical="13dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnPickGallery"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GALLERY FILE"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="@color/idroid_cyan"
            app:backgroundTint="@android:color/transparent"
            app:strokeColor="@color/idroid_cyan"
            app:strokeWidth="1.5dp"
            app:cornerRadius="8dp"
            android:paddingVertical="13dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminateTint="@color/idroid_cyan"
            android:layout_marginVertical="10dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Awaiting target acquisition. Capture or select food photo."
            android:textSize="12sp"
            android:textColor="@color/idroid_text_dim"
            android:textAlignment="center"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- ===================== History ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RATION LOG"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:textColor="@color/idroid_amber"
            android:fontFamily="monospace"
            android:layout_marginEnd="10dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/idroid_border" />
    </LinearLayout>

    <ListView
        android:id="@+id/listViewHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="vertical"
        android:scrollbarThumbVertical="@color/idroid_border" />

</LinearLayout>
