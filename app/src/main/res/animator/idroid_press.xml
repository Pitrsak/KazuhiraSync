<?xml version="1.0" encoding="utf-8"?>
<!-- Flat press feedback for the white highlight-bar buttons: a slight inset instead of Material elevation -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:state_enabled="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="0.985" android:duration="90" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="0.94" android:duration="90" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.0" android:duration="160" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.0" android:duration="160" android:valueType="floatType" />
        </set>
    </item>
</selector>
